# Copy this file to .env and replace each placeholder locally. Never commit .env.
NODE_ENV=development
PORT=3000

# Required for database-backed registration, staff data and badge status.
DATABASE_URL=postgresql://neondb_owner:replace-me@hostname.neon.tech/neondb?sslmode=require

# Admin login credentials for dashboard
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password
